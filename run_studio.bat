@echo off
chcp 65001 > nul
title Reels Studio AI

echo ===================================================
echo   Запуск кулинарной студии Reels Studio...
echo ===================================================

:: Переход в рабочую папку скрипта
cd /d "%~dp0"

:: Запуск браузера через 2 секунды (когда сервер успеет подняться)
start "" cmd /c "timeout /t 2 /nobreak > nul && start http://127.0.0.1:5000"

:: Запуск веб-сервера Flask
python app.py

pause